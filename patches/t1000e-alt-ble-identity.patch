diff --git a/src/helpers/nrf52/SerialBLEInterface.cpp b/src/helpers/nrf52/SerialBLEInterface.cpp
index 75a4e3b0..6e1e4757 100644
--- a/src/helpers/nrf52/SerialBLEInterface.cpp
+++ b/src/helpers/nrf52/SerialBLEInterface.cpp
@@ -133,6 +133,22 @@ void SerialBLEInterface::begin(const char* prefix, char* name, uint32_t pin_code
   // Bluefruit.autoConnLed(false);
   Bluefruit.configPrphBandwidth(BANDWIDTH_MAX);
   Bluefruit.begin();
+
+#if defined(BLE_ALT_IDENTITY)
+  // Recovery option for a central that retains an inaccessible stale bond.
+  // Derive a stable, per-device random-static address from the factory address
+  // so the central treats this firmware as a new Bluetooth identity. This does
+  // not alter the MeshCore/LoRa identity stored by the companion application.
+  ble_gap_addr_t alt_addr;
+  if (sd_ble_gap_addr_get(&alt_addr) == NRF_SUCCESS) {
+    alt_addr.addr_type = BLE_GAP_ADDR_TYPE_RANDOM_STATIC;
+    alt_addr.addr_id_peer = 0;
+    alt_addr.addr[0] ^= 0xA5;
+    alt_addr.addr[5] = (alt_addr.addr[5] & 0x3F) | 0xC0;
+    uint32_t addr_err = sd_ble_gap_addr_set(&alt_addr);
+    BLE_DEBUG_PRINTLN("SerialBLEInterface: alternate BLE identity status=%lu", addr_err);
+  }
+#endif
  
   char dev_name[32+16];
   if (strcmp(name, "@@MAC") == 0) {
